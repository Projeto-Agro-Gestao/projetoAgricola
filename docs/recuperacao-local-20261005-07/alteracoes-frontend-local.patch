+.ag-auth-premium .autenticacao-subtitulo { color: #405f4d; }
+.ag-auth-premium a:focus-visible,.ag-auth-premium button:focus-visible,.ag-auth-premium input:focus-visible { outline: 3px solid #a07619; outline-offset: 3px; }
+.ag-auth-cadastro.autenticacao { padding-top: 40px; }
+@supports not (backdrop-filter:blur(1px)) { .ag-auth-premium .autenticacao-formulario-container { background: #fafffb; } }
+.ag-auth-video-controle { position: relative; margin: 20px 0 0; padding: 10px 16px; color: #fff; background: rgba(5,30,17,.85); border: 1px solid rgba(255,255,255,.6); border-radius: 20px; cursor: pointer; font: inherit; }
